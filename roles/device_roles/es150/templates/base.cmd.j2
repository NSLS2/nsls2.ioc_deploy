
dbLoadDatabase("{{ deploy_ioc_template_root_path }}/dbd/{{ deploy_ioc_executable }}.dbd")
{{ deploy_ioc_executable }}_registerRecordDeviceDriver(pdbbase)

# es150 specific commands
epicsEnvSet("STREAM_PROTOCOL_PATH", "$(ES150)/protocol")


#Configure serial port for DC power supplies

{% for device in ioc.devices %}
drvAsynIPPortConfigure("{{ device.PORT }}", "{{ device.HOST }}:{{ device.IP_PORT }}")
{% endfor %}



